{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executor Request Contract",
  "type": "object",
  "required": ["executor_request"],
  "properties": {
    "executor_request": {
      "type": "object",
      "required": ["schema_version", "run_id", "node_id", "attempt_id", "adapter_type", "skill_ref", "input_artifact_refs", "profile_ref", "research_contract_ref", "permissions", "budget"],
      "properties": {
        "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
        "run_id": {"$ref": "common.schema.json#/$defs/run_id"},
        "node_id": {"$ref": "common.schema.json#/$defs/machine_id"},
        "attempt_id": {"$ref": "common.schema.json#/$defs/attempt_id"},
        "adapter_type": {"$ref": "common.schema.json#/$defs/adapter_type"},
        "skill_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@0\\.3\\.2$"},
        "input_artifact_refs": {"$ref": "common.schema.json#/$defs/artifact_refs"},
        "profile_ref": {"type": "string", "pattern": "^(developer_tool|ai_agent_product|consumer_app|b2b_saas)@0\\.3\\.2$"},
        "research_contract_ref": {
          "anyOf": [
            {"$ref": "common.schema.json#/$defs/artifact_ref"},
            {"type": "null"}
          ]
        },
        "interaction_resume": {
          "type": "object",
          "required": ["checkpoint_ref", "question_id"],
          "properties": {
            "checkpoint_ref": {"type": "string", "pattern": "^runtime/attempts/ATT-[A-Za-z0-9_-]+/checkpoints/CP-[A-Za-z0-9_-]+\\.json$"},
            "question_id": {"$ref": "common.schema.json#/$defs/question_id"},
            "selected_option_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
            "freeform_text": {"type": "string", "minLength": 1}
          },
          "anyOf": [
            {"required": ["selected_option_id"]},
            {"required": ["freeform_text"]}
          ],
          "additionalProperties": false
        },
        "permissions": {
          "type": "object",
          "required": ["external_access", "workspace_write_paths", "secrets"],
          "properties": {
            "external_access": {"enum": ["none", "read_only"]},
            "workspace_write_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/relative_path"}},
            "secrets": {"const": "forbidden"}
          },
          "additionalProperties": false
        },
        "budget": {
          "type": "object",
          "required": ["timeout_minutes", "max_sources", "token_limit", "cost_limit"],
          "properties": {
            "timeout_minutes": {"type": "integer", "minimum": 1},
            "max_sources": {"type": "integer", "minimum": 0},
            "token_limit": {"type": ["integer", "null"], "minimum": 1},
            "cost_limit": {"type": ["number", "null"], "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"required": ["interaction_resume"]},
          "then": {
            "properties": {
              "node_id": {"const": "idea"},
              "skill_ref": {"const": "idea-intake@0.3.2"},
              "research_contract_ref": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
