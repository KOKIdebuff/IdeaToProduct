{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitor Research Subgraph Contract",
  "type": "object",
  "required": ["subgraph", "inputs", "output_contracts", "nodes"],
  "properties": {
    "subgraph": {
      "type": "object",
      "required": ["id", "version", "schema_version"],
      "properties": {
        "id": {"const": "competitor-research"},
        "version": {"$ref": "common.schema.json#/$defs/schema_version"},
        "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/machine_id"}
    },
    "output_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifact_type", "producer"],
        "properties": {
          "artifact_type": {"$ref": "common.schema.json#/$defs/machine_id"},
          "producer": {"$ref": "common.schema.json#/$defs/machine_id"}
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "common.schema.json#/$defs/machine_id"},
      "additionalProperties": {"$ref": "workflow.schema.json#/$defs/node"}
    }
  },
  "additionalProperties": false
}
