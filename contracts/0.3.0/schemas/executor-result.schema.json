{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executor Result Contract",
  "type": "object",
  "required": ["executor_result"],
  "properties": {
    "executor_result": {
      "type": "object",
      "required": ["schema_version", "run_id", "node_id", "attempt_id", "status", "output_artifact_refs", "source_upserts", "usage", "error"],
      "properties": {
        "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
        "run_id": {"$ref": "common.schema.json#/$defs/run_id"},
        "node_id": {"$ref": "common.schema.json#/$defs/machine_id"},
        "attempt_id": {"$ref": "common.schema.json#/$defs/attempt_id"},
        "status": {"enum": ["COMPLETED", "WAITING_FOR_USER", "FAILED"]},
        "output_artifact_refs": {"$ref": "common.schema.json#/$defs/artifact_refs"},
        "source_upserts": {"type": "array", "items": {"$ref": "source.schema.json#/$defs/source"}},
        "interaction_request": {"$ref": "common.schema.json#/$defs/interaction_request"},
        "interaction_checkpoint": {"$ref": "common.schema.json#/$defs/interaction_checkpoint"},
        "usage": {
          "type": "object",
          "required": ["automated_duration_seconds", "source_count", "input_tokens", "output_tokens", "estimated_cost"],
          "properties": {
            "automated_duration_seconds": {"type": "number", "minimum": 0},
            "source_count": {"type": "integer", "minimum": 0},
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "estimated_cost": {"type": ["number", "null"], "minimum": 0}
          },
          "additionalProperties": false
        },
        "error": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common.schema.json#/$defs/structured_error"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "COMPLETED"}}},
          "then": {
            "properties": {"error": {"type": "null"}},
            "not": {
              "anyOf": [
                {"required": ["interaction_request"]},
                {"required": ["interaction_checkpoint"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "WAITING_FOR_USER"}}, "required": ["status"]},
          "then": {
            "required": ["interaction_request", "interaction_checkpoint"],
            "properties": {
              "error": {"type": "null"},
              "output_artifact_refs": {"maxItems": 0},
              "source_upserts": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "FAILED"}}},
          "then": {
            "properties": {"error": {"$ref": "common.schema.json#/$defs/structured_error"}},
            "not": {
              "anyOf": [
                {"required": ["interaction_request"]},
                {"required": ["interaction_checkpoint"]}
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
