{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Contracts",
  "$defs": {
    "verified_section": {
      "type": "object",
      "required": ["result", "issues"],
      "properties": {
        "result": {"$ref": "common.schema.json#/$defs/verification_result"},
        "issues": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/issue"}}
      },
      "additionalProperties": false
    },
    "skipped_section": {
      "type": "object",
      "required": ["status", "skip_reason"],
      "properties": {
        "status": {"const": "SKIPPED"},
        "skip_reason": {"const": "PROFILE_DISABLED"}
      },
      "additionalProperties": false
    },
    "section": {"oneOf": [{"$ref": "#/$defs/verified_section"}, {"$ref": "#/$defs/skipped_section"}]},
    "verification_summary": {
      "type": "object",
      "required": ["overall", "critical_issues", "non_critical_issues"],
      "properties": {
        "overall": {"$ref": "common.schema.json#/$defs/verification_result"},
        "critical_issues": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/issue"}},
        "non_critical_issues": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/issue"}}
      },
      "additionalProperties": false
    },
    "research_sections": {
      "type": "object",
      "required": ["competitor", "users", "market", "technology"],
      "properties": {
        "competitor": {"$ref": "#/$defs/section"},
        "users": {"$ref": "#/$defs/section"},
        "market": {"$ref": "#/$defs/section"},
        "technology": {"$ref": "#/$defs/section"}
      },
      "additionalProperties": false
    },
    "legacy_research_verification": {
      "type": "object",
      "required": ["verification", "sections"],
      "properties": {
        "verification": {"$ref": "#/$defs/verification_summary"},
        "sections": {"$ref": "#/$defs/research_sections"}
      },
      "additionalProperties": false
    },
    "research_verification": {
      "allOf": [
        {"$ref": "artifact.schema.json"},
        {
          "type": "object",
          "required": ["artifact", "verification", "sections"],
          "properties": {
            "artifact": {"type": "object", "properties": {"type": {"const": "research_verification"}}},
            "verification": {"$ref": "#/$defs/verification_summary"},
            "sections": {"$ref": "#/$defs/research_sections"}
          },
          "additionalProperties": false
        }
      ]
    },
    "competitor_issue": {
      "type": "object",
      "required": ["code", "critical", "retry_targets", "return_to"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": ["string", "null"]},
        "critical": {"type": "boolean"},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/evidence_id"}},
        "retry_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/machine_id"}},
        "return_to": {"const": "competitor_verifier"},
        "details": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "competitor_verification_summary": {
      "type": "object",
      "required": ["overall", "issues"],
      "properties": {
        "overall": {"$ref": "common.schema.json#/$defs/verification_result"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/competitor_issue"}}
      },
      "allOf": [
        {
          "if": {"properties": {"overall": {"const": "PASS"}}, "required": ["overall"]},
          "then": {"properties": {"issues": {"maxItems": 0}}},
          "else": {"properties": {"issues": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "competitor_verification": {
      "allOf": [
        {"$ref": "artifact.schema.json"},
        {
          "type": "object",
          "required": ["artifact", "verification"],
          "properties": {
            "artifact": {"type": "object", "properties": {"type": {"const": "competitor_verification"}}},
            "verification": {"$ref": "#/$defs/competitor_verification_summary"}
          },
          "additionalProperties": false
        }
      ]
    },
    "prd_consistency_verification": {
      "allOf": [
        {"$ref": "artifact.schema.json"},
        {
          "type": "object",
          "required": ["artifact", "verification"],
          "properties": {
            "artifact": {"type": "object", "properties": {"type": {"const": "prd_consistency_verification"}}},
            "verification": {
              "type": "object",
              "required": ["result", "checks", "issues"],
              "properties": {
                "result": {"enum": ["PASS", "FAIL"]},
                "checks": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/machine_id"}},
                "issues": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/issue"}}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/legacy_research_verification"},
    {"$ref": "#/$defs/research_verification"},
    {"$ref": "#/$defs/competitor_verification"},
    {"$ref": "#/$defs/prd_consistency_verification"}
  ]
}
